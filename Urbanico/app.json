{
  "expo": {
    "name": "Urbanico",
    "slug": "Frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/urbanico-icon.png",
    "scheme": "urbanico",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/urbanico-icon.png",
      "bundleIdentifier": "com.surajnyavanandi.Urbanico",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.surajnyavanandi.Urbanico"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/urbanico-favicon.jpg"
    },
    "plugins": [
      "expo-router",
      "expo-splash-screen"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": "",
      "eas": {
        "projectId": "1922d771-242d-4d6a-849f-876d79b90e70"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/1922d771-242d-4d6a-849f-876d79b90e70"
    },
    "owner": "surajnyavanandi"
  }
}
